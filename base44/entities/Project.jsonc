{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Project title"
    },
    "description": {
      "type": "string",
      "description": "Short project description"
    },
    "papers": {
      "type": "array",
      "description": "Selected papers for this project",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "authors": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "year": {
            "type": "number"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "order": {
      "type": "number",
      "description": "Display order"
    }
  },
  "required": [
    "title"
  ]
}